<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: نفس القاعدة للنسخ السحابي ونقل الجهاز. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
